# Supabase — create the project with the owner account (mpmony1@gmail.com), then copy these
# from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security, so it must never be prefixed
# NEXT_PUBLIC_ and never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Use only a launch URL generated/approved by your licensed
# provider/aggregator for this site/session. Do not commit live player tokens.
CRAZY_TIME_LAUNCH_URL=
